# Copy to .env and fill in. On Hugging Face add GROQ_API_KEY as a Space secret instead.
GROQ_API_KEY=

# Optional rate limits for the shared key (users who paste their own key are not limited)
FREE_TURNS_PER_HOUR=15
FREE_TURNS_PER_DAY=300

# Log verbosity for the agent/tool-call logs (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO
